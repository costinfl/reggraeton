<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runtime support classes of the generated Playwright projects. The sources of this module are
  copied (with the package renamed) into every project `reggraeton convert` writes, so generated
  projects are self-contained and need no private artifact repository.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.reggraeton</groupId>
    <artifactId>reggraeton-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>reggraeton-runtime</artifactId>
  <name>reggraeton-runtime</name>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
    </dependency>

    <!--
      Optional: each generated project gets only the support classes its mode needs.
      native mode: JUnit API + tag expressions (RegressionTest, Scenario, DataTable, ScenarioScope, TagFilter);
      bdd mode: Cucumber (PlaywrightHooks).
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>tag-expressions</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
          </environmentVariables>
          <systemPropertyVariables>
            <!-- browser tests are opt-in: -Dreggraeton.browserTests=true [-Dbrowser.channel=chromium] -->
            <reggraeton.browserTests>${reggraeton.browserTests}</reggraeton.browserTests>
            <browser.channel>${browser.channel}</browser.channel>
            <browser.executable>${browser.executable}</browser.executable>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
